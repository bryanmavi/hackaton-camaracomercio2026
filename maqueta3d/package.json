{
  "name": "cali-activa-territorio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "data": "node scripts/build-territory.mjs",
    "test": "node --test scripts/*.test.mjs",
    "test:e2e": "playwright test",
    "deliverables": "playwright test tests/zz-deliverables.spec.ts && node scripts/verify-deliverables.mjs",
    "verify:deliverables": "node scripts/verify-deliverables.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.6",
    "@react-three/fiber": "9.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "@turf/turf": "7.2.0",
    "leaflet": "1.9.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-leaflet": "5.0.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/geojson": "7946.0.16",
    "@types/leaflet": "1.9.20",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.0.3",
    "gltf-validator": "2.0.0-dev.3.10",
    "typescript": "5.9.2",
    "vite": "7.3.6"
  }
}
